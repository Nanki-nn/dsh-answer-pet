{
  "name": "dsh-answer-pet",
  "version": "0.5.0",
  "type": "module",
  "description": "DeepSeek Harness Web 蓝鲸桌面宠物：实时显示多会话回答进度、模型轨迹、工具调用、token、输出速率与耗时。",
  "author": {
    "name": "Nanki-nn",
    "email": "1113049408@qq.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nanki-nn/dsh-answer-pet.git"
  },
  "homepage": "https://github.com/Nanki-nn/dsh-answer-pet#readme",
  "bugs": {
    "url": "https://github.com/Nanki-nn/dsh-answer-pet/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "answer-progress",
    "multi-session"
  ],
  "files": [
    ".dsh-plugin",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
